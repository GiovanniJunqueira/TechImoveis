# Copie para .env.local e preencha.
# Desenvolvimento local: rode `npx supabase status` e use "API URL" e "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Armazenamento de arquivos (API S3).
# Local: Supabase Storage (`npx supabase status` mostra as chaves S3); bucket "documentos" criado pelo config.
# Produção: Cloudflare R2 -> S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto.
S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_BUCKET=documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
